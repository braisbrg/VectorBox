engine-strict=true
frozen-lockfile=true
audit=true
# Leave FALSE. Dependency build scripts are already default-DENIED by pnpm 10+
# via the onlyBuiltDependencies allowlist in pnpm-workspace.yaml (@clerk/shared,
# sharp, unrs-resolver — written by `pnpm approve-builds`). Setting
# ignore-scripts=true here would ALSO skip those three, breaking sharp's native
# binary and the Clerk postinstall, while adding no security we don't have.
ignore-scripts=false
save-exact=false
