    "clsx": "2.1.1",
    "framer-motion": "13.1.1",
    "lucide-react": "1.39.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "postcss": "^8.5.18",
    "react": "19.2.8",
